                        <!-- Troubleshooting -->
                        <TextBlock Text="Troubleshooting" Style="{StaticResource SectionHeader}"/>
                        <Border Style="{StaticResource SectionBorder}">
                            <StackPanel>
                                <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource BrushPrimary}" FontWeight="SemiBold" FontSize="12" Margin="0,0,0,4">
                                    LDAP connection fails or times out
                                </TextBlock>
                                <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource BrushText}" FontSize="11" Margin="0,0,0,10">
                                    Verify the domain controller has a valid LDAPS certificate (port 636). If not, enable Allow Insecure LDAP to fall back to port 389 with Kerberos sealing. Increase the LDAP Timeout in Configuration if queries time out on large domains.
                                </TextBlock>

                                <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource BrushPrimary}" FontWeight="SemiBold" FontSize="12" Margin="0,0,0,4">
                                    Groups are skipped during enumeration
                                </TextBlock>
                                <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource BrushText}" FontSize="11" Margin="0,0,0,10">
                                    Groups exceeding the Large Group Threshold are skipped automatically. Increase the threshold in the Enumeration tab or Configuration tab. Groups listed in Skip Groups are also excluded.
                                </TextBlock>

                                <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource BrushPrimary}" FontWeight="SemiBold" FontSize="12" Margin="0,0,0,4">
                                    Fuzzy matching produces poor results
                                </TextBlock>
                                <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource BrushText}" FontSize="11" Margin="0,0,0,10">
                                    Lower the Fuzzy Min Score (e.g., 0.6) for more lenient matching, or raise it (e.g., 0.85) for stricter matching. Add environment-specific prefixes (GG_, SEC_, DL_) to the Fuzzy Prefixes list so they are stripped before comparison.
                                </TextBlock>

                                <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource BrushPrimary}" FontWeight="SemiBold" FontSize="12" Margin="0,0,0,4">
                                    SQLite backend fails to initialize
                                </TextBlock>
                                <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource BrushText}" FontSize="11" Margin="0,0,0,10">
                                    The SQLite backend requires Python (3.6+) in PATH. Verify with 'python --version' or 'python3 --version'. The JSON backend has zero external dependencies and is recommended for most deployments.
                                </TextBlock>

                                <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource BrushPrimary}" FontWeight="SemiBold" FontSize="12" Margin="0,0,0,4">
                                    Reports are not generated
                                </TextBlock>
                                <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource BrushText}" FontSize="11">
                                    Ensure report checkboxes are enabled in the Reports tab. If JSON Only is checked, HTML reports are suppressed. Check the Output Log on the Run tab for specific error messages during report generation.
                                </TextBlock>
