<Window
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    x:Name="MainWindowRoot"
    Title="Group Enumerator v3.0"
    Width="1100"
    Height="700"
    MinWidth="900"
    MinHeight="600"
    WindowStartupLocation="CenterScreen"
    Background="{DynamicResource BrushBackground}"
    Foreground="{DynamicResource BrushText}"
    FontFamily="Segoe UI"
    FontSize="13">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Styles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>  <!-- Title bar -->
            <RowDefinition Height="*"/>     <!-- Main content (TabControl) -->
            <RowDefinition Height="28"/>    <!-- Status bar -->
        </Grid.RowDefinitions>

        <!-- ============================================================
             Row 0: Title bar with label, version, and Close button
             ============================================================ -->
        <Grid Grid.Row="0" Background="{DynamicResource BrushSurfaceAlt}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="Group Enumerator"
                       Foreground="{DynamicResource BrushPrimary}"
                       FontSize="14" FontWeight="SemiBold"
                       VerticalAlignment="Center" Margin="12,6,6,6"/>
            <TextBlock Grid.Column="1" Text="v3.0"
                       Foreground="{DynamicResource BrushTextSubtle}"
                       FontSize="11" VerticalAlignment="Center"
                       Margin="0,6,0,6"/>
            <Button Grid.Column="3" x:Name="BtnCloseApp" Content="X  Close"
                    Background="#8B2E2E" Foreground="#FFFFFF"
                    BorderBrush="#C04040" BorderThickness="1"
                    Padding="14,4" FontSize="12" FontWeight="SemiBold"
                    FontFamily="Segoe UI" Cursor="Hand"
                    Margin="4,2,6,2" VerticalAlignment="Center"
                    ToolTip="Close the application (Alt+F4)"/>
        </Grid>

        <!-- ============================================================
             Row 1: TabControl with 6 tabs
             ============================================================ -->
        <TabControl x:Name="MainTabControl"
                    Grid.Row="1"
                    Background="{DynamicResource BrushBackground}"
                    BorderThickness="0"
                    Margin="0">

            <!-- ========================================================
                 Tab 1: Run (primary workflow)
                 ======================================================== -->
            <TabItem Header="Run" Style="{StaticResource ToolkitTabItem}">
                <Grid Background="{DynamicResource BrushBackground}" Margin="12,8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>  <!-- Input section -->
                        <RowDefinition Height="Auto"/>  <!-- Command preview -->
                        <RowDefinition Height="Auto"/>  <!-- Action bar -->
                        <RowDefinition Height="*"/>     <!-- Log viewer -->
                    </Grid.RowDefinitions>

                    <!-- Row 0: Input Section -->
                    <StackPanel Grid.Row="0" Margin="0,0,0,12">

                        <!-- CSV Path -->
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="180"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="80"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="CSV Input File"
                                       Style="{StaticResource FieldLabel}"/>
                            <TextBox Grid.Column="1" x:Name="TxtCsvPath"
                                     Style="{StaticResource FieldBox}" Margin="0,0,8,0"
                                     ToolTip="Path to the CSV file containing group pairs or group names for enumeration"/>
                            <Button Grid.Column="2" x:Name="BtnBrowseCsv" Content="Browse"
                                    Style="{StaticResource SecondaryButton}"
                                    Padding="10,4" FontSize="11"
                                    ToolTip="Browse for a CSV file"/>
                        </Grid>

                        <!-- Data Source: Live AD vs Previous run (report from a saved cache, no AD) -->
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="180"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Data Source" Style="{StaticResource FieldLabel}"/>
                            <StackPanel Grid.Column="1" Orientation="Horizontal">
                                <RadioButton x:Name="RdoSrcLive" GroupName="DataSource" Content="Live AD" IsChecked="True"
                                             Foreground="{DynamicResource BrushText}" FontSize="12" Margin="0,0,16,0"
                                             ToolTip="Enumerate live from Active Directory using the CSV above."/>
                                <RadioButton x:Name="RdoSrcCache" GroupName="DataSource" Content="Use saved data"
                                             Foreground="{DynamicResource BrushText}" FontSize="12"
                                             ToolTip="Report on data already pulled from AD in a previous run (no new AD query). Latest run preselected."/>
                            </StackPanel>
                        </Grid>

                        <!-- Previous-run picker (active when Data Source = Previous run) -->
                        <Grid x:Name="GrdPrevRun" Margin="0,0,0,8" IsEnabled="False">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="180"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="80"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Saved run" Style="{StaticResource FieldLabel}"/>
                            <ComboBox Grid.Column="1" x:Name="CmbPrevRun" Style="{StaticResource FieldCombo}" Margin="0,0,8,0"
                                      ToolTip="Recent saved runs, newest first. Optional — pick a specific older run; the latest is used by default."/>
                            <Button Grid.Column="2" x:Name="BtnBrowsePrevRun" Content="Browse"
                                    Style="{StaticResource SecondaryButton}" Padding="10,4" FontSize="11"
                                    ToolTip="Browse for a specific JSON cache file"/>
                        </Grid>
                        <!-- Holds the resolved previous-run cache FILE (internal state read by the command builder) -->
                        <TextBox x:Name="TxtPrevRunCache" Visibility="Collapsed" IsReadOnly="True"/>

                        <!-- Preset -->
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="180"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Preset"
                                       Style="{StaticResource FieldLabel}"/>
                            <ComboBox Grid.Column="1" x:Name="CmbPreset"
                                      Style="{StaticResource FieldCombo}"
                                      ToolTip="Select a preset configuration that sets multiple options at once">
                                <ComboBoxItem Content="Basic Inventory" IsSelected="True"/>
                                <ComboBoxItem Content="Nested+Stale"/>
                                <ComboBoxItem Content="Cross-Domain Migration"/>
                                <ComboBoxItem Content="Compliance Audit"/>
                                <ComboBoxItem Content="Full Analysis"/>
                                <ComboBoxItem Content="Custom"/>
                            </ComboBox>
                        </Grid>

                        <!-- Credential (optional) -->
                        <Grid Margin="0,0,0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="180"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="8"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Credential (optional)"
                                       Style="{StaticResource FieldLabel}"/>
                            <TextBox Grid.Column="1" x:Name="TxtUsername"
                                     Style="{StaticResource FieldBox}"
                                     ToolTip="Username for LDAP bind (domain\user or user@domain). Leave blank for current credentials."/>
                            <PasswordBox Grid.Column="3" x:Name="PwdPassword"
                                         Style="{StaticResource FieldPassword}"
                                         PasswordChar="*"
                                         ToolTip="Password for the LDAP bind account"/>
                        </Grid>
                    </StackPanel>

                    <!-- Row 1: Command Preview -->
                    <StackPanel Grid.Row="1" Margin="0,0,0,12">
                        <Grid Margin="0,0,0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Command Preview"
                                       Foreground="{DynamicResource BrushTextMuted}"
                                       FontSize="11" VerticalAlignment="Center"/>
                            <Button Grid.Column="1" x:Name="BtnCopyCommand"
                                    Content="Copy Command"
                                    Style="{StaticResource SecondaryButton}"
                                    Padding="10,2" FontSize="10"
                                    ToolTip="Copy the command to clipboard"/>
                        </Grid>
                        <TextBox x:Name="TxtCommandPreview"
                                 IsReadOnly="True"
                                 FontFamily="Consolas" FontSize="11"
                                 Height="60"
                                 TextWrapping="Wrap"
                                 VerticalScrollBarVisibility="Auto"
                                 Background="{DynamicResource BrushSurfaceAlt}"
                                 Foreground="{DynamicResource BrushText}"
                                 BorderBrush="{DynamicResource BrushBorder}"
                                 BorderThickness="1"
                                 Padding="8,4"/>
                    </StackPanel>

                    <!-- Row 2: Action Bar -->
                    <Grid Grid.Row="2" Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="16"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="8"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="0" x:Name="BtnRun"
                                Content="_Run Enumeration"
                                Style="{StaticResource ToolkitButton}"
                                Width="200" Height="40" FontSize="14"
                                ToolTip="Start group enumeration (F5)"/>
                        <ProgressBar Grid.Column="2" x:Name="PrgProgress"
                                     Height="20" Visibility="Collapsed"
                                     Background="{DynamicResource BrushSurfaceAlt}"
                                     Foreground="{DynamicResource BrushPrimary}"
                                     BorderBrush="{DynamicResource BrushBorder}"
                                     BorderThickness="1"/>
                        <TextBlock Grid.Column="3" x:Name="TxtProgressPercent"
                                   Foreground="{DynamicResource BrushTextMuted}"
                                   VerticalAlignment="Center" FontSize="12"
                                   Margin="8,0,0,0"/>
                        <Button Grid.Column="5" x:Name="BtnCancel"
                                Content="_Cancel"
                                Style="{StaticResource DangerButton}"
                                Visibility="Collapsed"
                                Padding="14,6"
                                ToolTip="Cancel the running enumeration (Escape)"/>
                    </Grid>

                    <!-- Row 3: Log Viewer -->
                    <Grid Grid.Row="3">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Text="Output Log"
                                   Foreground="{DynamicResource BrushTextMuted}"
                                   FontSize="11" Margin="0,0,0,4"/>
                        <Border Grid.Row="1" Background="{DynamicResource BrushSurface}"
                                CornerRadius="6" BorderBrush="{DynamicResource BrushBorder}"
                                BorderThickness="1">
                            <TextBox x:Name="TxtLog"
                                     IsReadOnly="True"
                                     VerticalScrollBarVisibility="Auto"
                                     FontFamily="Consolas" FontSize="11"
                                     TextWrapping="Wrap"
                                     AcceptsReturn="True"
                                     Background="Transparent"
                                     Foreground="{DynamicResource BrushText}"
                                     BorderThickness="0"
                                     Padding="8,6"/>
                        </Border>
                    </Grid>
                </Grid>
            </TabItem>

            <!-- ========================================================
                 Tab 2: Enumeration (option toggles)
                 ======================================================== -->
            <TabItem Header="Enumeration" Style="{StaticResource ToolkitTabItem}">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Background="{DynamicResource BrushBackground}">
                    <StackPanel Margin="12,8">

                        <!-- Section: Core Options -->
                        <TextBlock Text="Core Options" Style="{StaticResource SectionHeader}" Margin="0,4,0,8"/>
                        <Border Style="{StaticResource SectionBorder}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="30"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="8"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="8"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="8"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="8"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <CheckBox Grid.Row="0" Grid.Column="0" x:Name="ChkFuzzyMatch"
                                          Content="Fuzzy Match" Style="{StaticResource FieldCheckBox}"
                                          ToolTip="Enable cross-domain group name matching using Levenshtein similarity"/>
                                <Button Grid.Row="0" Grid.Column="1" Style="{StaticResource InfoButton}"
                                        ToolTip="Fuzzy matching compares group names across AD domains using Levenshtein distance. A score of 0.0-1.0 determines match confidence."/>

                                <CheckBox Grid.Row="2" Grid.Column="0" x:Name="ChkResolveNested"
                                          Content="Resolve Nested Groups" Style="{StaticResource FieldCheckBox}"
                                          ToolTip="Flatten nested group memberships to single-level user list"/>
                                <Button Grid.Row="2" Grid.Column="1" Style="{StaticResource InfoButton}"
                                        ToolTip="Recursively resolves all nested groups to produce a flat list of unique member users."/>

                                <CheckBox Grid.Row="4" Grid.Column="0" x:Name="ChkDetectStale"
                                          Content="Detect Stale Accounts" Style="{StaticResource FieldCheckBox}"
                                          ToolTip="Flag accounts with no logon in N days (default 90)"/>
                                <Button Grid.Row="4" Grid.Column="1" Style="{StaticResource InfoButton}"
                                        ToolTip="Checks lastLogonTimestamp against a configurable threshold to identify inactive accounts."/>

                                <CheckBox Grid.Row="6" Grid.Column="0" x:Name="ChkAnalyzeGaps"
                                          Content="Analyze Migration Gaps" Style="{StaticResource FieldCheckBox}"
                                          ToolTip="Run gap analysis on matched group pairs. Requires Fuzzy Match."/>
                                <Button Grid.Row="6" Grid.Column="1" Style="{StaticResource InfoButton}"
                                        ToolTip="Compares source and target group members to identify Ready, AddToGroup, NotProvisioned, and OrphanedAccess statuses."/>

                                <CheckBox Grid.Row="8" Grid.Column="0" x:Name="ChkIncludeManager"
                                          Content="Include manager/dept/title" Style="{StaticResource FieldCheckBox}"
                                          ToolTip="Capture AD manager, department and title per member (-IncludeAttributes manager,department,title). Required for the Org Role Map's cache-based (single-hop / Adhoc) tree; enriches other reports."/>
                                <Button Grid.Row="8" Grid.Column="1" Style="{StaticResource InfoButton}"
                                        ToolTip="The Org Role Map builds its manager hierarchy from these attributes. The live deep-walk fetches managers directly; the DC-free single-hop / Adhoc path reads them from the cache."/>
                            </Grid>
                        </Border>

                        <!-- Section: Performance -->
                        <TextBlock Text="Performance" Style="{StaticResource SectionHeader}"/>
                        <Border Style="{StaticResource SectionBorder}">
                            <StackPanel>
                                <CheckBox x:Name="ChkIncremental"
                                          Content="Incremental Mode" Style="{StaticResource FieldCheckBox}"
                                          ToolTip="Only re-enumerate groups whose AD whenChanged timestamp has advanced since last run"
                                          Margin="0,0,0,8"/>
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="180"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Large Group Threshold"
                                               Style="{StaticResource FieldLabel}"/>
                                    <TextBox x:Name="TxtLargeGroupThreshold"
                                             Style="{StaticResource FieldBox}"
                                             Text="5000" Width="100" HorizontalAlignment="Left"
                                             ToolTip="Skip groups with more than N members (default 5000)"/>
                                </Grid>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="180"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Skip Groups"
                                               Style="{StaticResource FieldLabel}"/>
                                    <TextBox x:Name="TxtSkipGroups"
                                             Style="{StaticResource FieldBox}"
                                             ToolTip="Comma-separated list of group names to always skip"/>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- Section: Security -->
                        <TextBlock Text="Security" Style="{StaticResource SectionHeader}"/>
                        <Border Style="{StaticResource SectionBorder}">
                            <StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <CheckBox Grid.Column="0" x:Name="ChkAllowInsecure"
                                              Content="Allow Insecure LDAP" Style="{StaticResource FieldCheckBox}"
                                              ToolTip="WARNING: Enables LDAP 389 fallback with Kerberos sealing. Use only when LDAPS certificates are unavailable."/>
                                    <TextBlock Grid.Column="1" Text="[!]"
                                               Foreground="{DynamicResource BrushWarning}"
                                               FontWeight="Bold" FontSize="14"
                                               VerticalAlignment="Center" Margin="8,0,0,0"
                                               ToolTip="Security warning: plaintext LDAP is not recommended"/>
                                </Grid>
                                <Border Background="{DynamicResource BrushSurfaceAlt}"
                                        CornerRadius="4" Padding="10,6" Margin="0,8,0,0">
                                    <TextBlock TextWrapping="Wrap" FontSize="11"
                                               Foreground="{DynamicResource BrushWarning}">
                                        LDAPS (port 636) is always preferred. Only enable insecure LDAP when the domain controller does not have a valid certificate and Kerberos sealing provides sufficient transport protection.
                                    </TextBlock>
                                </Border>
                            </StackPanel>
                        </Border>

                        <!-- Section: Change Tracking -->
                        <TextBlock Text="Change Tracking" Style="{StaticResource SectionHeader}"/>
                        <Border Style="{StaticResource SectionBorder}">
                            <StackPanel>
                                <CheckBox x:Name="ChkTrackChanges"
                                          Content="Track Changes" Style="{StaticResource FieldCheckBox}"
                                          ToolTip="Enable persistent daily change tracking. Maintains state across runs to detect membership adds/removes."
                                          Margin="0,0,0,8"/>
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="180"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Change Type"
                                               Style="{StaticResource FieldLabel}"/>
                                    <ComboBox x:Name="CmbChangeType"
                                              Style="{StaticResource FieldCombo}"
                                              Width="160" HorizontalAlignment="Left"
                                              ToolTip="Which changes to report: additions, removals, or both">
                                        <ComboBoxItem Content="Both" IsSelected="True"/>
                                        <ComboBoxItem Content="Added"/>
                                        <ComboBoxItem Content="Removed"/>
                                    </ComboBox>
                                </Grid>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="180"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Change Period"
                                               Style="{StaticResource FieldLabel}"/>
                                    <ComboBox x:Name="CmbChangePeriod"
                                              Style="{StaticResource FieldCombo}"
                                              Width="160" HorizontalAlignment="Left"
                                              ToolTip="Time window for historical change data in reports">
                                        <ComboBoxItem Content="(none)" IsSelected="True"/>
                                        <ComboBoxItem Content="Day"/>
                                        <ComboBoxItem Content="Week"/>
                                        <ComboBoxItem Content="Month"/>
                                        <ComboBoxItem Content="Quarter"/>
                                        <ComboBoxItem Content="Custom"/>
                                    </ComboBox>
                                </Grid>
                                <!-- Custom change window (active when Change Period = Custom): days-back or an explicit Since date -->
                                <Grid x:Name="GrdChangeCustom" Margin="0,8,0,0" IsEnabled="False">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="180"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Custom window" Style="{StaticResource FieldLabel}"/>
                                    <TextBox Grid.Column="1" x:Name="TxtChangeDays" Width="70" Style="{StaticResource FieldBox}"
                                             ToolTip="Days back (e.g. 14). Used when Change Period = Custom and no Since date is set."/>
                                    <TextBlock Grid.Column="2" Text="days  or since:" VerticalAlignment="Center" Margin="8,0,8,0"
                                               Foreground="{DynamicResource BrushText}" FontSize="12"/>
                                    <DatePicker Grid.Column="3" x:Name="DpChangeSince" HorizontalAlignment="Left" Width="140"
                                                ToolTip="Explicit start date for change history (overrides the days value)."/>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- Section: State Backend -->
                        <TextBlock Text="State Backend" Style="{StaticResource SectionHeader}"/>
                        <Border Style="{StaticResource SectionBorder}">
                            <StackPanel>
                                <RadioButton x:Name="RdoBackendJson"
                                             Content="JSON (default)" GroupName="Backend"
                                             IsChecked="True" Foreground="{DynamicResource BrushText}"
                                             FontSize="12" Margin="0,0,0,6"
                                             ToolTip="Zero-dependency file-based state. Group-as-PK with unified state file."/>
                                <RadioButton x:Name="RdoBackendSqlite"
                                             Content="SQLite" GroupName="Backend"
                                             Foreground="{DynamicResource BrushText}"
                                             FontSize="12" Margin="0,0,0,8"
                                             ToolTip="Requires Python. Better for 1000+ groups or queryable audit history."/>
                                <CheckBox x:Name="ChkUnifiedState"
                                          Content="Unified State" Style="{StaticResource FieldCheckBox}"
                                          IsChecked="True"
                                          ToolTip="Single state file for all groups (v2). Uncheck for legacy per-CSV state."
                                          Margin="0,0,0,6"/>
                                <CheckBox x:Name="ChkLegacy"
                                          Content="Legacy Mode" Style="{StaticResource FieldCheckBox}"
                                          ToolTip="Use v1 per-CSV state file naming (backward compatibility)"/>
                            </StackPanel>
                        </Border>

                        <!-- Section: Advanced -->
                        <TextBlock Text="Advanced" Style="{StaticResource SectionHeader}"/>
                        <Border Style="{StaticResource SectionBorder}">
                            <StackPanel>
                                <CheckBox x:Name="ChkFromCache"
                                          Content="From Cache (skip LDAP)" Style="{StaticResource FieldCheckBox}"
                                          ToolTip="Load previously saved JSON cache instead of querying AD. Use for offline report regeneration."
                                          Margin="0,0,0,8"/>
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="180"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Migrating To"
                                               Style="{StaticResource FieldLabel}"/>
                                    <TextBox x:Name="TxtMigratingTo"
                                             Style="{StaticResource FieldBox}"
                                             ToolTip="Target domain for migration (e.g. TARGETDOMAIN). Used by gap analysis."/>
                                </Grid>
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="180"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Baseline Path"
                                               Style="{StaticResource FieldLabel}"/>
                                    <TextBox x:Name="TxtBaselinePath"
                                             Style="{StaticResource FieldBox}"
                                             ToolTip="Path to a baseline JSON snapshot for drift comparison"/>
                                </Grid>
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="180"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Previous Run Path"
                                               Style="{StaticResource FieldLabel}"/>
                                    <TextBox x:Name="TxtPreviousRunPath"
                                             Style="{StaticResource FieldBox}"
                                             ToolTip="Path to a previous run JSON snapshot for run-to-run drift comparison"/>
                                </Grid>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="180"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="App Mapping CSV"
                                               Style="{StaticResource FieldLabel}"/>
                                    <TextBox x:Name="TxtAppMappingCsv"
                                             Style="{StaticResource FieldBox}"
                                             ToolTip="Path to CSV mapping applications to AD group pairs (AppName,SourceGroup,TargetGroup,Notes)"/>
                                </Grid>
                            </StackPanel>
                        </Border>

                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ========================================================
                 Tab 3: Reports (report selection)
                 ======================================================== -->
            <TabItem Header="Reports" Style="{StaticResource ToolkitTabItem}">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Background="{DynamicResource BrushBackground}">
                    <StackPanel Margin="12,8">

                        <!-- One-click: generate the selected reports from the latest saved run (no AD) -->
                        <Border Style="{StaticResource SectionBorder}" Margin="0,4,0,10">
                            <StackPanel>
                                <Button x:Name="BtnReportFromSaved" Content="Generate Reports from Saved Data (latest)"
                                        Style="{StaticResource SecondaryButton}" HorizontalAlignment="Left" Padding="14,6"
                                        ToolTip="Run the report types selected below using the most recent saved run -- no Active Directory query."/>
                                <TextBlock Text="Uses the most recent saved run (no AD). Tick the report types below first. For a specific older run or a live AD run, use the Run tab's Data Source."
                                           Style="{StaticResource FieldLabel}" TextWrapping="Wrap" Margin="0,6,0,0"/>
                            </StackPanel>
                        </Border>

                        <!-- Section: Report Types -->
                        <TextBlock Text="Report Types" Style="{StaticResource SectionHeader}" Margin="0,4,0,8"/>
                        <Border Style="{StaticResource SectionBorder}">
                            <StackPanel>
                                <CheckBox x:Name="ChkAllReports"
                                          Content="Generate All Reports" Style="{StaticResource FieldCheckBox}"
                                          ToolTip="Enable all four report types below"
                                          Margin="0,0,0,8"/>
                                <Separator Background="{DynamicResource BrushBorder}" Margin="0,0,0,8"/>
                                <CheckBox x:Name="ChkGovernanceReport"
                                          Content="Access Governance Report" Style="{StaticResource FieldCheckBox}"
                                          ToolTip="SailPoint-style identity-centric access certification. Inline CSS, Word-compatible."
                                          Margin="0,0,0,6"/>
                                <CheckBox x:Name="ChkComplianceReport"
                                          Content="Compliance Audit Report" Style="{StaticResource FieldCheckBox}"
                                          ToolTip="Point-in-time audit evidence with drift analysis and reviewer sign-off. Word-compatible."
                                          Margin="0,0,0,6"/>
                                <CheckBox x:Name="ChkExecutiveDashboard"
                                          Content="Executive Dashboard" Style="{StaticResource FieldCheckBox}"
                                          ToolTip="High-level KPI dashboard with SVG donut charts and trend indicators."
                                          Margin="0,0,0,6"/>
                                <CheckBox x:Name="ChkLeadershipSummary"
                                          Content="Leadership Summary" Style="{StaticResource FieldCheckBox}"
                                          ToolTip="1-page director-level rollup. Word-compatible."/>
                                <Separator Background="{DynamicResource BrushBorder}" Margin="0,8,0,8"/>
                                <CheckBox x:Name="ChkBaselineReports"
                                          Content="Baseline Governance Reports &#8212; All (10)" Style="{StaticResource FieldCheckBox}"
                                          ToolTip="Generate all 10 baseline reports. Overrides the individual selections below. Leave unchecked to pick specific ones."/>
                                <StackPanel Margin="18,4,0,0">
                                    <CheckBox x:Name="ChkBlRoster"       Content="Membership Roster"            Style="{StaticResource FieldCheckBox}" Margin="0,0,0,3"/>
                                    <CheckBox x:Name="ChkBlAccessCert"   Content="Access Certification"         Style="{StaticResource FieldCheckBox}" Margin="0,0,0,3"/>
                                    <CheckBox x:Name="ChkBlPrivileged"   Content="Privileged Group Review"      Style="{StaticResource FieldCheckBox}" Margin="0,0,0,3"/>
                                    <CheckBox x:Name="ChkBlSod"          Content="SoD / Toxic Co-membership"    Style="{StaticResource FieldCheckBox}" Margin="0,0,0,3"/>
                                    <CheckBox x:Name="ChkBlOrphaned"     Content="Orphaned / Disabled Members"  Style="{StaticResource FieldCheckBox}" Margin="0,0,0,3"/>
                                    <CheckBox x:Name="ChkBlInventory"    Content="Group Inventory Catalog"      Style="{StaticResource FieldCheckBox}" Margin="0,0,0,3"/>
                                    <CheckBox x:Name="ChkBlEmptyStale"   Content="Empty / Stale Groups"         Style="{StaticResource FieldCheckBox}" Margin="0,0,0,3"/>
                                    <CheckBox x:Name="ChkBlNestedAudit"  Content="Nested Membership Audit"      Style="{StaticResource FieldCheckBox}" Margin="0,0,0,3"/>
                                    <CheckBox x:Name="ChkBlExecSummary"  Content="Governance Executive Summary" Style="{StaticResource FieldCheckBox}" Margin="0,0,0,3"/>
                                    <CheckBox x:Name="ChkBlChangeAttest" Content="Membership Change Attestation" Style="{StaticResource FieldCheckBox}"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- Section: Composable Report (pick components) -->
                        <TextBlock Text="Composable Report" Style="{StaticResource SectionHeader}"/>
                        <Border Style="{StaticResource SectionBorder}">
                            <StackPanel>
                                <TextBlock Text="Pick components to assemble into one report (-ReportComponents). Order is top-to-bottom; check &#189; to make a component half-width so two consecutive halves sit side-by-side."
                                           TextWrapping="Wrap" Style="{StaticResource FieldLabel}" Margin="0,0,0,8"/>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,3">
                                    <CheckBox x:Name="ChkRcKpiCards" Content="Summary KPI Cards" Style="{StaticResource FieldCheckBox}" Width="250"
                                              ToolTip="Headline counts: groups, members, empty, domains, at-risk."/>
                                    <CheckBox x:Name="ChkRcKpiCardsHalf" Content="&#189; width" Style="{StaticResource FieldCheckBox}"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,3">
                                    <CheckBox x:Name="ChkRcHeatmap" Content="Member-Count Heatmap" Style="{StaticResource FieldCheckBox}" Width="250"
                                              ToolTip="Density grid: one cell per group, coloured by member count."/>
                                    <CheckBox x:Name="ChkRcHeatmapHalf" Content="&#189; width" Style="{StaticResource FieldCheckBox}"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,3">
                                    <CheckBox x:Name="ChkRcTopN" Content="Top-N Groups (bars)" Style="{StaticResource FieldCheckBox}" Width="250"
                                              ToolTip="Largest groups as horizontal bars."/>
                                    <CheckBox x:Name="ChkRcTopNHalf" Content="&#189; width" Style="{StaticResource FieldCheckBox}"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,3">
                                    <CheckBox x:Name="ChkRcTree" Content="Drill-down Membership Tree" Style="{StaticResource FieldCheckBox}" Width="250"
                                              ToolTip="Expandable group to members hierarchy (numbers by default)."/>
                                    <CheckBox x:Name="ChkRcTreeHalf" Content="&#189; width" Style="{StaticResource FieldCheckBox}"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,3">
                                    <CheckBox x:Name="ChkRcDiff" Content="Membership Change Diff" Style="{StaticResource FieldCheckBox}" Width="250"
                                              ToolTip="Per-group adds/removes from the changelog (needs change tracking data)."/>
                                    <CheckBox x:Name="ChkRcDiffHalf" Content="&#189; width" Style="{StaticResource FieldCheckBox}"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,3">
                                    <CheckBox x:Name="ChkRcGroupTable" Content="Condensed Group Table" Style="{StaticResource FieldCheckBox}" Width="250"
                                              ToolTip="One row per group: name, domain, member count, nested, skipped."/>
                                    <CheckBox x:Name="ChkRcGroupTableHalf" Content="&#189; width" Style="{StaticResource FieldCheckBox}"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,3">
                                    <CheckBox x:Name="ChkRcRiskFlags" Content="Governance Risk Flags" Style="{StaticResource FieldCheckBox}" Width="250"
                                              ToolTip="Risk snapshot: disabled members, empty groups, oversized/skipped, nested."/>
                                    <CheckBox x:Name="ChkRcRiskFlagsHalf" Content="&#189; width" Style="{StaticResource FieldCheckBox}"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,3">
                                    <CheckBox x:Name="ChkRcPrivRisk" Content="Privileged-Access Risk" Style="{StaticResource FieldCheckBox}" Width="250"
                                              ToolTip="Disabled accounts still in privileged groups (critical governance finding)."/>
                                    <CheckBox x:Name="ChkRcPrivRiskHalf" Content="&#189; width" Style="{StaticResource FieldCheckBox}"/>
                                </StackPanel>
                                <Grid Margin="0,8,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="180"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Report Title" Style="{StaticResource FieldLabel}"/>
                                    <TextBox x:Name="TxtComponentTitle" Grid.Column="1" Style="{StaticResource FieldBox}"
                                             Text="Composable Group Report" ToolTip="Title shown at the top of the composed report (-ComponentReportTitle)."/>
                                </Grid>
                                <CheckBox x:Name="ChkComponentDark" Content="Dark theme" Style="{StaticResource FieldCheckBox}" Margin="0,6,0,0"
                                          ToolTip="Render the composed report with the dark palette (-ComponentReportTheme dark)."/>
                            </StackPanel>
                        </Border>

                        <!-- Section: Output Options -->
                        <TextBlock Text="Output Options" Style="{StaticResource SectionHeader}"/>
                        <Border Style="{StaticResource SectionBorder}">
                            <StackPanel>
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="180"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Theme"
                                               Style="{StaticResource FieldLabel}"/>
                                    <ComboBox x:Name="CmbTheme"
                                              Style="{StaticResource FieldCombo}"
                                              Width="120" HorizontalAlignment="Left"
                                              ToolTip="HTML report color theme">
                                        <ComboBoxItem Content="dark" IsSelected="True"/>
                                        <ComboBoxItem Content="light"/>
                                    </ComboBox>
                                </Grid>
                                <CheckBox x:Name="ChkExportMembersCsv"
                                          Content="Export Members CSV" Style="{StaticResource FieldCheckBox}"
                                          ToolTip="Generate flat roster CSV of all enumerated members"
                                          Margin="0,0,0,6"/>
                                <CheckBox x:Name="ChkJsonOnly"
                                          Content="JSON Only (skip HTML)" Style="{StaticResource FieldCheckBox}"
                                          ToolTip="Generate only JSON cache file, no HTML report"
                                          Margin="0,0,0,6"/>
                                <CheckBox x:Name="ChkNoCache"
                                          Content="No Cache" Style="{StaticResource FieldCheckBox}"
                                          ToolTip="Skip saving JSON cache file after enumeration"
                                          Margin="0,0,0,6"/>
                                <CheckBox x:Name="ChkSendEmail"
                                          Content="Send Email Report" Style="{StaticResource FieldCheckBox}"
                                          ToolTip="Email migration readiness summary after report generation"/>
                            </StackPanel>
                        </Border>

                        <!-- Section: Output Preview -->
                        <TextBlock Text="Output Preview" Style="{StaticResource SectionHeader}"/>
                        <Border Style="{StaticResource SectionBorder}">
                            <TextBlock x:Name="TxtOutputPreview"
                                       Foreground="{DynamicResource BrushTextMuted}"
                                       FontSize="12" FontFamily="Consolas"
                                       TextWrapping="Wrap"
                                       Text="Select report options above to see which files will be generated."/>
                        </Border>

                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ========================================================
                 Tab 4: Configuration (settings editor)
                 ======================================================== -->
            <TabItem Header="Configuration" Style="{StaticResource ToolkitTabItem}">
                <Grid Background="{DynamicResource BrushBackground}" Margin="12,8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>     <!-- Scrollable form -->
                        <RowDefinition Height="Auto"/>  <!-- Action bar -->
                    </Grid.RowDefinitions>

                    <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="0,4,0,8">

                            <!-- LDAP Connection -->
                            <TextBlock Text="LDAP Connection" Style="{StaticResource SectionHeader}" Margin="0,4,0,8"/>
                            <Border Style="{StaticResource SectionBorder}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="180"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="8"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="8"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <TextBlock Grid.Row="0" Grid.Column="0" Text="LDAP Page Size"
                                               Style="{StaticResource FieldLabel}"/>
                                    <TextBox Grid.Row="0" Grid.Column="1" x:Name="TxtLdapPageSize"
                                             Style="{StaticResource FieldBox}" Text="1000"
                                             Width="100" HorizontalAlignment="Left"
                                             ToolTip="Number of results per LDAP query page (default 1000)"/>

                                    <TextBlock Grid.Row="2" Grid.Column="0" Text="LDAP Timeout (sec)"
                                               Style="{StaticResource FieldLabel}"/>
                                    <TextBox Grid.Row="2" Grid.Column="1" x:Name="TxtLdapTimeout"
                                             Style="{StaticResource FieldBox}" Text="120"
                                             Width="100" HorizontalAlignment="Left"
                                             ToolTip="LDAP query timeout in seconds (default 120)"/>

                                    <TextBlock Grid.Row="4" Grid.Column="0" Text="Max Member Count"
                                               Style="{StaticResource FieldLabel}"/>
                                    <TextBox Grid.Row="4" Grid.Column="1" x:Name="TxtMaxMemberCount"
                                             Style="{StaticResource FieldBox}" Text="5000"
                                             Width="100" HorizontalAlignment="Left"
                                             ToolTip="Maximum members to enumerate per group before skipping (default 5000)"/>
                                </Grid>
                            </Border>

                            <!-- Fuzzy Matching -->
                            <TextBlock Text="Fuzzy Matching" Style="{StaticResource SectionHeader}"/>
                            <Border Style="{StaticResource SectionBorder}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="180"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="8"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Fuzzy Prefixes"
                                               Style="{StaticResource FieldLabel}"/>
                                    <TextBox Grid.Row="0" Grid.Column="1" x:Name="TxtFuzzyPrefixes"
                                             Style="{StaticResource FieldBox}"
                                             ToolTip="Comma-separated list of prefixes to strip before comparing group names (e.g. GRP_,SEC_,DL_)"/>

                                    <TextBlock Grid.Row="2" Grid.Column="0" Text="Fuzzy Min Score"
                                               Style="{StaticResource FieldLabel}"/>
                                    <TextBox Grid.Row="2" Grid.Column="1" x:Name="TxtFuzzyMinScore"
                                             Style="{StaticResource FieldBox}" Text="0.75"
                                             Width="100" HorizontalAlignment="Left"
                                             ToolTip="Minimum Levenshtein similarity score (0.0-1.0) to consider a match (default 0.75)"/>
                                </Grid>
                            </Border>

                            <!-- Stale Detection -->
                            <TextBlock Text="Stale Detection" Style="{StaticResource SectionHeader}"/>
                            <Border Style="{StaticResource SectionBorder}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="180"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Grid.Column="0" Text="Stale Account Days"
                                               Style="{StaticResource FieldLabel}"/>
                                    <TextBox Grid.Column="1" x:Name="TxtStaleAccountDays"
                                             Style="{StaticResource FieldBox}" Text="90"
                                             Width="100" HorizontalAlignment="Left"
                                             ToolTip="Number of days since last logon before an account is considered stale (default 90)"/>
                                </Grid>
                            </Border>

                            <!-- Correlation -->
                            <TextBlock Text="Correlation" Style="{StaticResource SectionHeader}"/>
                            <Border Style="{StaticResource SectionBorder}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="180"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Grid.Column="0" Text="Correlation Strategy"
                                               Style="{StaticResource FieldLabel}"/>
                                    <ComboBox Grid.Column="1" x:Name="CmbCorrelationStrategy"
                                              Style="{StaticResource FieldCombo}"
                                              Width="160" HorizontalAlignment="Left"
                                              ToolTip="Identity correlation order: email-first uses mail attribute, sam-first uses sAMAccountName">
                                        <ComboBoxItem Content="email-first" IsSelected="True"/>
                                        <ComboBoxItem Content="sam-first"/>
                                    </ComboBox>
                                </Grid>
                            </Border>

                            <!-- Nested Groups -->
                            <TextBlock Text="Nested Groups" Style="{StaticResource SectionHeader}"/>
                            <Border Style="{StaticResource SectionBorder}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="180"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Grid.Column="0" Text="Max Nesting Depth"
                                               Style="{StaticResource FieldLabel}"/>
                                    <TextBox Grid.Column="1" x:Name="TxtNestedGroupMaxDepth"
                                             Style="{StaticResource FieldBox}" Text="10"
                                             Width="100" HorizontalAlignment="Left"
                                             ToolTip="Maximum depth for nested group resolution (default 10). Higher values may increase execution time."/>
                                </Grid>
                            </Border>

                            <!-- Logging -->
                            <TextBlock Text="Logging" Style="{StaticResource SectionHeader}"/>
                            <Border Style="{StaticResource SectionBorder}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="180"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="8"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="8"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Log Enabled"
                                               Style="{StaticResource FieldLabel}"/>
                                    <CheckBox Grid.Row="0" Grid.Column="1" x:Name="ChkLogEnabled"
                                              Style="{StaticResource FieldCheckBox}" IsChecked="True"
                                              ToolTip="Enable or disable log file output"/>

                                    <TextBlock Grid.Row="2" Grid.Column="0" Text="Log Level"
                                               Style="{StaticResource FieldLabel}"/>
                                    <ComboBox Grid.Row="2" Grid.Column="1" x:Name="CmbLogLevel"
                                              Style="{StaticResource FieldCombo}"
                                              Width="120" HorizontalAlignment="Left"
                                              ToolTip="Minimum log level written to file">
                                        <ComboBoxItem Content="DEBUG"/>
                                        <ComboBoxItem Content="INFO" IsSelected="True"/>
                                        <ComboBoxItem Content="WARN"/>
                                    </ComboBox>

                                    <TextBlock Grid.Row="4" Grid.Column="0" Text="Log Path"
                                               Style="{StaticResource FieldLabel}"/>
                                    <TextBox Grid.Row="4" Grid.Column="1" x:Name="TxtLogPath"
                                             Style="{StaticResource FieldBox}"
                                             ToolTip="Directory or file path for log output"/>
                                    <Button Grid.Row="4" Grid.Column="2" x:Name="BtnBrowseLogPath"
                                            Content="Browse" Style="{StaticResource SecondaryButton}"
                                            Padding="10,4" FontSize="11" Margin="6,0,0,0"
                                            ToolTip="Browse for log output directory"/>
                                </Grid>
                            </Border>

                            <!-- Email Delivery -->
                            <TextBlock Text="Email Delivery" Style="{StaticResource SectionHeader}"/>
                            <Border Style="{StaticResource SectionBorder}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="180"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="8"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="8"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="8"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="8"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="8"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="8"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="8"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <TextBlock Grid.Row="0" Grid.Column="0" Text="SMTP Server"
                                               Style="{StaticResource FieldLabel}"/>
                                    <TextBox Grid.Row="0" Grid.Column="1" x:Name="TxtSmtpServer"
                                             Style="{StaticResource FieldBox}"
                                             ToolTip="SMTP relay server hostname or IP"/>

                                    <TextBlock Grid.Row="2" Grid.Column="0" Text="SMTP Port"
                                               Style="{StaticResource FieldLabel}"/>
                                    <TextBox Grid.Row="2" Grid.Column="1" x:Name="TxtSmtpPort"
                                             Style="{StaticResource FieldBox}" Text="587"
                                             Width="100" HorizontalAlignment="Left"
                                             ToolTip="SMTP port (25, 587, or 465)"/>

                                    <TextBlock Grid.Row="4" Grid.Column="0" Text="Use SSL"
                                               Style="{StaticResource FieldLabel}"/>
                                    <CheckBox Grid.Row="4" Grid.Column="1" x:Name="ChkSmtpUseSsl"
                                              Style="{StaticResource FieldCheckBox}" IsChecked="True"
                                              ToolTip="Enable TLS/SSL for SMTP connection"/>

                                    <TextBlock Grid.Row="6" Grid.Column="0" Text="From"
                                               Style="{StaticResource FieldLabel}"/>
                                    <TextBox Grid.Row="6" Grid.Column="1" x:Name="TxtSmtpFrom"
                                             Style="{StaticResource FieldBox}"
                                             ToolTip="Sender email address"/>

                                    <TextBlock Grid.Row="8" Grid.Column="0" Text="To"
                                               Style="{StaticResource FieldLabel}"/>
                                    <TextBox Grid.Row="8" Grid.Column="1" x:Name="TxtSmtpTo"
                                             Style="{StaticResource FieldBox}"
                                             ToolTip="Recipient email address(es), comma-separated"/>

                                    <TextBlock Grid.Row="10" Grid.Column="0" Text="Cc"
                                               Style="{StaticResource FieldLabel}"/>
                                    <TextBox Grid.Row="10" Grid.Column="1" x:Name="TxtSmtpCc"
                                             Style="{StaticResource FieldBox}"
                                             ToolTip="CC recipients, comma-separated (optional)"/>

                                    <TextBlock Grid.Row="12" Grid.Column="0" Text="Subject Prefix"
                                               Style="{StaticResource FieldLabel}"/>
                                    <TextBox Grid.Row="12" Grid.Column="1" x:Name="TxtSmtpSubjectPrefix"
                                             Style="{StaticResource FieldBox}"
                                             Text="[Group-Enumerator]"
                                             ToolTip="Prefix prepended to email subject lines"/>

                                    <TextBlock Grid.Row="14" Grid.Column="0" Text="Attach Report"
                                               Style="{StaticResource FieldLabel}"/>
                                    <CheckBox Grid.Row="14" Grid.Column="1" x:Name="ChkSmtpAttachReport"
                                              Style="{StaticResource FieldCheckBox}" IsChecked="True"
                                              ToolTip="Attach the HTML report file to the email"/>
                                </Grid>
                            </Border>

                            <!-- Changelog -->
                            <TextBlock Text="Changelog" Style="{StaticResource SectionHeader}"/>
                            <Border Style="{StaticResource SectionBorder}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="180"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="8"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Max Changelog Size (MB)"
                                               Style="{StaticResource FieldLabel}"/>
                                    <TextBox Grid.Row="0" Grid.Column="1" x:Name="TxtMaxChangeLogSizeMB"
                                             Style="{StaticResource FieldBox}" Text="50"
                                             Width="100" HorizontalAlignment="Left"
                                             ToolTip="Maximum changelog file size in megabytes before rotation"/>

                                    <TextBlock Grid.Row="2" Grid.Column="0" Text="Retention Days"
                                               Style="{StaticResource FieldLabel}"/>
                                    <TextBox Grid.Row="2" Grid.Column="1" x:Name="TxtRetentionDays"
                                             Style="{StaticResource FieldBox}" Text="365"
                                             Width="100" HorizontalAlignment="Left"
                                             ToolTip="Number of days to retain changelog entries"/>
                                </Grid>
                            </Border>

                            <!-- Paths -->
                            <TextBlock Text="Paths" Style="{StaticResource SectionHeader}"/>
                            <Border Style="{StaticResource SectionBorder}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="180"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="8"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="8"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="8"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Output Directory"
                                               Style="{StaticResource FieldLabel}"/>
                                    <TextBox Grid.Row="0" Grid.Column="1" x:Name="TxtOutputDirectory"
                                             Style="{StaticResource FieldBox}"
                                             ToolTip="Base directory for all output files"/>
                                    <Button Grid.Row="0" Grid.Column="2" x:Name="BtnBrowseOutputDir"
                                            Content="Browse" Style="{StaticResource SecondaryButton}"
                                            Padding="10,4" FontSize="11" Margin="6,0,0,0"
                                            ToolTip="Browse for output directory"/>

                                    <TextBlock Grid.Row="2" Grid.Column="0" Text="Cache Path"
                                               Style="{StaticResource FieldLabel}"/>
                                    <TextBox Grid.Row="2" Grid.Column="1" x:Name="TxtCachePath"
                                             Style="{StaticResource FieldBox}"
                                             ToolTip="Path to the JSON cache file directory"/>

                                    <TextBlock Grid.Row="4" Grid.Column="0" Text="State Path"
                                               Style="{StaticResource FieldLabel}"/>
                                    <TextBox Grid.Row="4" Grid.Column="1" x:Name="TxtStatePath"
                                             Style="{StaticResource FieldBox}"
                                             ToolTip="Path to the state tracking file directory"/>

                                    <TextBlock Grid.Row="6" Grid.Column="0" Text="SQLite DB Path"
                                               Style="{StaticResource FieldLabel}"/>
                                    <TextBox Grid.Row="6" Grid.Column="1" x:Name="TxtSqliteDbPath"
                                             Style="{StaticResource FieldBox}"
                                             ToolTip="Path to the SQLite database file (used when backend is SQLite)"/>
                                </Grid>
                            </Border>

                        </StackPanel>
                    </ScrollViewer>

                    <!-- Action Bar -->
                    <Border Grid.Row="1" Background="{DynamicResource BrushSurfaceAlt}"
                            BorderBrush="{DynamicResource BrushBorder}"
                            BorderThickness="0,1,0,0" Padding="0,10,0,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <Button Grid.Column="0" x:Name="BtnSaveConfig"
                                    Content="_Save Configuration"
                                    Style="{StaticResource ToolkitButton}"
                                    Margin="0,0,8,0"
                                    ToolTip="Save current configuration to disk (Ctrl+S)"/>
                            <Button Grid.Column="1" x:Name="BtnResetConfig"
                                    Content="R_eset to Defaults"
                                    Style="{StaticResource SecondaryButton}"
                                    Margin="0,0,8,0"
                                    ToolTip="Reset all settings to factory defaults (does not save until you click Save)"/>
                            <Button Grid.Column="3" x:Name="BtnLoadConfig"
                                    Content="_Load Config File..."
                                    Style="{StaticResource SecondaryButton}"
                                    ToolTip="Load settings from a different JSON configuration file"/>
                        </Grid>
                    </Border>
                </Grid>
            </TabItem>

            <!-- ========================================================
                 Tab: Change Tracking (state DB stats + change explorer)
                 ======================================================== -->
            <TabItem Header="Change Tracking" Style="{StaticResource ToolkitTabItem}">
                <Grid Background="{DynamicResource BrushBackground}" Margin="12,8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>   <!-- Stats panel -->
                        <RowDefinition Height="Auto"/>   <!-- Explorer filter bar -->
                        <RowDefinition Height="*"/>      <!-- Changes DataGrid -->
                    </Grid.RowDefinitions>

                    <!-- Stats panel -->
                    <StackPanel Grid.Row="0">
                        <TextBlock Text="State Database" Style="{StaticResource SectionHeader}"/>
                        <Border Style="{StaticResource SectionBorder}">
                            <StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="170"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="170"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Backend" Style="{StaticResource FieldLabel}"/>
                                    <TextBlock Grid.Row="0" Grid.Column="1" x:Name="TxtCtBackend" Text="-" FontWeight="SemiBold" Margin="0,0,0,4"/>
                                    <TextBlock Grid.Row="0" Grid.Column="2" Text="State DB / path" Style="{StaticResource FieldLabel}"/>
                                    <TextBlock Grid.Row="0" Grid.Column="3" x:Name="TxtCtDbPath" Text="-" TextTrimming="CharacterEllipsis" Margin="0,0,0,4"/>
                                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Groups" Style="{StaticResource FieldLabel}"/>
                                    <TextBlock Grid.Row="1" Grid.Column="1" x:Name="TxtCtGroups" Text="-" FontWeight="SemiBold" Margin="0,0,0,4"/>
                                    <TextBlock Grid.Row="1" Grid.Column="2" Text="Changelog (added / removed)" Style="{StaticResource FieldLabel}"/>
                                    <TextBlock Grid.Row="1" Grid.Column="3" x:Name="TxtCtChanges" Text="-" FontWeight="SemiBold" Margin="0,0,0,4"/>
                                    <TextBlock Grid.Row="2" Grid.Column="0" Text="Members (memberships)" Style="{StaticResource FieldLabel}"/>
                                    <TextBlock Grid.Row="2" Grid.Column="1" x:Name="TxtCtMembers" Text="-" FontWeight="SemiBold" Margin="0,0,0,4"/>
                                    <TextBlock Grid.Row="2" Grid.Column="2" Text="Distinct users" Style="{StaticResource FieldLabel}"/>
                                    <TextBlock Grid.Row="2" Grid.Column="3" x:Name="TxtCtDistinct" Text="-" FontWeight="SemiBold" Margin="0,0,0,4"/>
                                    <TextBlock Grid.Row="3" Grid.Column="0" Text="Runs / CSV sources" Style="{StaticResource FieldLabel}"/>
                                    <TextBlock Grid.Row="3" Grid.Column="1" x:Name="TxtCtRuns" Text="-" FontWeight="SemiBold"/>
                                </Grid>
                                <TextBlock x:Name="TxtCtStatsNote" Text="A user in many groups counts once under Distinct users. SQLite (group-as-PK) backend recommended for cross-CSV history."
                                           TextWrapping="Wrap" Style="{StaticResource FieldLabel}" Margin="0,6,0,6"/>
                                <Button x:Name="BtnCtRefresh" Content="Refresh Stats" Style="{StaticResource SecondaryButton}"
                                        HorizontalAlignment="Left" ToolTip="Read the current state database statistics"/>
                                <Button x:Name="BtnCtValidate" Content="Check Consistency" Style="{StaticResource SecondaryButton}"
                                        HorizontalAlignment="Left" Margin="0,8,0,0" ToolTip="Audit the state database for integrity / consistency (read-only)"/>
                                <TextBlock x:Name="TxtCtConsistency" Text="" TextWrapping="Wrap" FontFamily="Consolas" FontSize="11" Margin="0,8,0,0"/>
                                <Button x:Name="BtnCtPrivRisk" Content="Privileged Risk Check" Style="{StaticResource SecondaryButton}"
                                        HorizontalAlignment="Left" Margin="0,12,0,0" ToolTip="Flag disabled (and stale/never-logged-in) accounts still in privileged groups, from the latest cache (read-only)"/>
                                <TextBlock x:Name="TxtCtPrivRisk" Text="" TextWrapping="Wrap" FontFamily="Consolas" FontSize="11" Margin="0,8,0,0"/>
                                <!-- Membership churn / re-grant ("access flapping") report -->
                                <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                                    <Button x:Name="BtnCtChurn" Content="Churn / Re-grant Report" Style="{StaticResource SecondaryButton}"
                                            ToolTip="Find accounts Removed then Added again (access flapping) over a window. Reads the change ledger and writes an HTML report."/>
                                    <TextBlock Text="days" VerticalAlignment="Center" Margin="12,0,4,0" Foreground="{DynamicResource BrushText}" FontSize="12"/>
                                    <TextBox x:Name="TxtCtChurnDays" Width="50" Text="30" Style="{StaticResource FieldBox}" VerticalAlignment="Center"/>
                                    <TextBlock Text="min re-grants" VerticalAlignment="Center" Margin="12,0,4,0" Foreground="{DynamicResource BrushText}" FontSize="12"/>
                                    <TextBox x:Name="TxtCtChurnMin" Width="40" Text="1" Style="{StaticResource FieldBox}" VerticalAlignment="Center"/>
                                    <CheckBox x:Name="ChkCtChurnPriv" Content="Privileged only" VerticalAlignment="Center" Margin="12,0,0,0"
                                              Foreground="{DynamicResource BrushText}" FontSize="12"/>
                                </StackPanel>
                                <TextBlock x:Name="TxtCtChurn" Text="" TextWrapping="Wrap" FontFamily="Consolas" FontSize="11" Margin="0,8,0,0"/>
                                <!-- Org Role Map: manager -> group -> user COUNTS (where privileged roles concentrate) -->
                                <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                                    <Button x:Name="BtnOrmRun" Content="Org Role Map" Style="{StaticResource SecondaryButton}"
                                            ToolTip="Manager -&gt; group -&gt; user as COUNTS over an org tree (where privileged roles concentrate). Self-contained HTML: SVG map + table. Full/Adhoc use the latest cache; Delta uses the change ledger."/>
                                    <TextBlock Text="mode" VerticalAlignment="Center" Margin="12,0,4,0" Foreground="{DynamicResource BrushText}" FontSize="12"/>
                                    <ComboBox x:Name="CmbOrmMode" Width="90" Style="{StaticResource FieldCombo}" VerticalAlignment="Center">
                                        <ComboBoxItem Content="Adhoc" IsSelected="True"/>
                                        <ComboBoxItem Content="Delta"/>
                                        <ComboBoxItem Content="Full"/>
                                    </ComboBox>
                                    <CheckBox x:Name="ChkOrmPriv" Content="Privileged only" VerticalAlignment="Center" Margin="12,0,0,0"
                                              Foreground="{DynamicResource BrushText}" FontSize="12"/>
                                    <CheckBox x:Name="ChkOrmDeep" Content="Build full org tree (live DC)" VerticalAlignment="Center" Margin="12,0,0,0"
                                              Foreground="{DynamicResource BrushText}" FontSize="12"
                                              ToolTip="Full mode only: walk each member's manager chain to the top via LDAP (needs DC reachability; uses the AllowInsecure setting). Unchecked = single-hop tree from the cache (no DC)."/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                    <TextBlock Text="Delta days" VerticalAlignment="Center" Margin="0,0,4,0" Foreground="{DynamicResource BrushText}" FontSize="12"/>
                                    <TextBox x:Name="TxtOrmDays" Width="48" Text="30" Style="{StaticResource FieldBox}" VerticalAlignment="Center"
                                             ToolTip="Delta mode window in days back (default 30)."/>
                                    <TextBlock Text="max-stale" VerticalAlignment="Center" Margin="12,0,4,0" Foreground="{DynamicResource BrushText}" FontSize="12"/>
                                    <TextBox x:Name="TxtOrmStale" Width="48" Text="30" Style="{StaticResource FieldBox}" VerticalAlignment="Center"
                                             ToolTip="Org-tree staleness threshold in days (banner + StaleCache gate; default 30)."/>
                                    <TextBlock Text="depth" VerticalAlignment="Center" Margin="12,0,4,0" Foreground="{DynamicResource BrushText}" FontSize="12"/>
                                    <TextBox x:Name="TxtOrmDepth" Width="48" Text="20" Style="{StaticResource FieldBox}" VerticalAlignment="Center"
                                             ToolTip="Max manager-chain depth for the deep walk (default 20)."/>
                                    <TextBlock Text="open lvl" VerticalAlignment="Center" Margin="12,0,4,0" Foreground="{DynamicResource BrushText}" FontSize="12"/>
                                    <TextBox x:Name="TxtOrmOpenDepth" Width="40" Text="2" Style="{StaticResource FieldBox}" VerticalAlignment="Center"
                                             ToolTip="How many levels of the org map are expanded on open (default 2 = CEO/VP/Director). Set high (e.g. 9) to open fully expanded."/>
                                    <CheckBox x:Name="ChkOrmCsv" Content="Export CSV" VerticalAlignment="Center" Margin="14,0,0,0"
                                              Foreground="{DynamicResource BrushText}" FontSize="12" ToolTip="Also write the placement rows (org path, group, counts) to a CSV in the output directory."/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                    <TextBlock Text="groups" VerticalAlignment="Center" Margin="0,0,4,0" Foreground="{DynamicResource BrushText}" FontSize="12"/>
                                    <TextBox x:Name="TxtOrmGroups" Width="240" Style="{StaticResource FieldBox}" VerticalAlignment="Center"
                                             ToolTip="Optional: track only these group names (comma-separated, wildcards ok, e.g. GG_Finance_*,SAP_*). Blank = all groups in the snapshot."/>
                                    <TextBlock Text="server" VerticalAlignment="Center" Margin="12,0,4,0" Foreground="{DynamicResource BrushText}" FontSize="12"/>
                                    <TextBox x:Name="TxtOrmServer" Width="170" Style="{StaticResource FieldBox}" VerticalAlignment="Center"
                                             ToolTip="Optional deep-walk DC override. Blank = auto-derive from the snapshot domain."/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                    <CheckBox x:Name="ChkOrmAllPriv" Content="All groups privileged" VerticalAlignment="Center" Margin="0,0,0,0"
                                              Foreground="{DynamicResource BrushText}" FontSize="12"
                                              ToolTip="Treat every tracked group as privileged (for estates where all tracked roles are privileged). Overrides the name-pattern detection."/>
                                    <TextBlock Text="priv patterns (regex)" VerticalAlignment="Center" Margin="14,0,4,0" Foreground="{DynamicResource BrushText}" FontSize="12"/>
                                    <TextBox x:Name="TxtOrmPrivPattern" Width="240" Style="{StaticResource FieldBox}" VerticalAlignment="Center"
                                             ToolTip="Optional custom privileged-name regex (comma-separated), added to the built-in admin/operator detection. e.g. CyberArk,\bIAM\b,AWS,PAM,Vault,Sailpoint. Ignored when 'All groups privileged' is on."/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                    <TextBlock Text="Fail on:" VerticalAlignment="Center" Margin="0,0,8,0" Foreground="{DynamicResource BrushText}" FontSize="12"/>
                                    <CheckBox x:Name="ChkOrmFailStale" Content="StaleCache" VerticalAlignment="Center" Margin="0,0,10,0"
                                              Foreground="{DynamicResource BrushText}" FontSize="12" ToolTip="Exit 2 if the org-tree cache is older than max-stale."/>
                                    <CheckBox x:Name="ChkOrmFailUnmanaged" Content="UnmanagedBucket" VerticalAlignment="Center" Margin="0,0,10,0"
                                              Foreground="{DynamicResource BrushText}" FontSize="12" ToolTip="Exit 2 if too high a share of privileged refs are unmanaged (service accounts / no manager)."/>
                                    <CheckBox x:Name="ChkOrmFailPriv" Content="PrivConcentration" VerticalAlignment="Center"
                                              Foreground="{DynamicResource BrushText}" FontSize="12" ToolTip="Exit 2 if one branch holds too high a share of privileged refs."/>
                                </StackPanel>
                                <TextBox x:Name="TxtOrmCache" Style="{StaticResource FieldBox}" Margin="0,6,0,0"
                                         ToolTip="Optional: snapshot cache JSON (enumerated with -IncludeAttributes manager) for Full/Adhoc. Leave blank to use the newest file in Cache\."/>
                                <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                    <CheckBox x:Name="ChkOrmReconExport" Content="Export reconciliation (JSON+CSV)" Style="{StaticResource FieldCheckBox}" VerticalAlignment="Center"
                                              ToolTip="When ticked, additionally write the AD reconciliation model (versioned JSON + CSV twin) to the output dir via Invoke-OrgRoleMap -ReconExport. Off = today's Org Role Map behavior, unchanged."/>
                                    <TextBlock Text="org top" VerticalAlignment="Center" Margin="14,0,4,0" Foreground="{DynamicResource BrushText}" FontSize="12"/>
                                    <TextBox x:Name="TxtOrmOrgTop" Width="160" Style="{StaticResource FieldBox}" VerticalAlignment="Center" ToolTip="OrgTop sAMAccountName"/>
                                    <TextBlock Text="join key" VerticalAlignment="Center" Margin="12,0,4,0" Foreground="{DynamicResource BrushText}" FontSize="12"/>
                                    <TextBox x:Name="TxtOrmJoinKey" Width="140" Style="{StaticResource FieldBox}" VerticalAlignment="Center" ToolTip="JoinKeyAttribute, hint employeeID"/>
                                </StackPanel>
                                <TextBlock x:Name="TxtOrmResult" Text="" TextWrapping="Wrap" FontFamily="Consolas" FontSize="11" Margin="0,8,0,0"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- Explorer filter bar -->
                    <StackPanel Grid.Row="1">
                        <TextBlock Text="Change Explorer" Style="{StaticResource SectionHeader}"/>
                        <Border Style="{StaticResource SectionBorder}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="200"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="140"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="CSV (optional)" Style="{StaticResource FieldLabel}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <TextBox  Grid.Column="1" x:Name="TxtCtCsvFilter" Style="{StaticResource FieldBox}"
                                          ToolTip="Filter to one CSV source's groups (per-CSV view via provenance). Leave blank for all."/>
                                <TextBlock Grid.Column="2" Text="Period" Style="{StaticResource FieldLabel}" VerticalAlignment="Center" Margin="16,0,8,0"/>
                                <ComboBox Grid.Column="3" x:Name="CboCtPeriod" Style="{StaticResource FieldCombo}">
                                    <ComboBoxItem Content="All" IsSelected="True"/>
                                    <ComboBoxItem Content="Day"/>
                                    <ComboBoxItem Content="Week"/>
                                    <ComboBoxItem Content="Month"/>
                                    <ComboBoxItem Content="Quarter"/>
                                </ComboBox>
                                <Button Grid.Column="4" x:Name="BtnCtQuery" Content="Query Changes" Style="{StaticResource SecondaryButton}"
                                        Margin="16,0,0,0" ToolTip="Query the changelog with the filters above"/>
                            </Grid>
                        </Border>
                    </StackPanel>

                    <!-- Changes DataGrid -->
                    <Border Grid.Row="2" Background="{DynamicResource BrushSurface}" CornerRadius="6"
                            BorderBrush="{DynamicResource BrushBorder}" BorderThickness="1" Margin="0,8,0,0">
                        <DataGrid x:Name="DgCtChanges" AutoGenerateColumns="False"
                                  Style="{StaticResource DataGridStyle}" CellStyle="{StaticResource DataGridCellStyle}">
                            <DataGrid.ColumnHeaderStyle>
                                <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource DataGridColumnHeaderStyle}"/>
                            </DataGrid.ColumnHeaderStyle>
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Timestamp" Binding="{Binding Timestamp}" Width="170" IsReadOnly="True"/>
                                <DataGridTextColumn Header="Action" Binding="{Binding Action}" Width="80" IsReadOnly="True"/>
                                <DataGridTextColumn Header="Domain" Binding="{Binding Domain}" Width="140" IsReadOnly="True"/>
                                <DataGridTextColumn Header="Group" Binding="{Binding GroupName}" Width="*" IsReadOnly="True"/>
                                <DataGridTextColumn Header="Account" Binding="{Binding SamAccountName}" Width="140" IsReadOnly="True"/>
                                <DataGridTextColumn Header="Display Name" Binding="{Binding DisplayName}" Width="180" IsReadOnly="True"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Border>
                </Grid>
            </TabItem>

            <!-- ========================================================
                 Tab: Reconciliation (ISC change diff + membership backfill)
                 ======================================================== -->
            <TabItem Header="Reconciliation" Style="{StaticResource ToolkitTabItem}">
                <Grid Background="{DynamicResource BrushBackground}" Margin="12,8">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <!-- B1: ISC Change Diff -->
                            <TextBlock Text="ISC Change Diff" Style="{StaticResource SectionHeader}"/>
                            <Border Style="{StaticResource SectionBorder}">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                        <TextBlock Text="feed CSV" VerticalAlignment="Center" Margin="0,0,4,0" Foreground="{DynamicResource BrushText}" FontSize="12"/>
                                        <TextBox x:Name="TxtIscFeed" Width="360" Style="{StaticResource FieldBox}" VerticalAlignment="Center"
                                                 ToolTip="Blank auto-picks the newest groups-isc-changes-both*.csv under Output\, then State\, then the tool root."/>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                        <CheckBox x:Name="ChkIscAllPriv" Content="Treat all groups as privileged" Style="{StaticResource FieldCheckBox}" VerticalAlignment="Center"
                                                  ToolTip="Treat every group in the feed as privileged for the diff (overrides name-pattern detection)."/>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                        <Button x:Name="BtnIscRun" Content="ISC Change Diff" Style="{StaticResource SecondaryButton}"
                                                HorizontalAlignment="Left" ToolTip="Run Invoke-IscChangeDiff.ps1 and open the HTML diff."/>
                                    </StackPanel>
                                    <TextBlock x:Name="TxtIscResult" Text="" TextWrapping="Wrap" FontFamily="Consolas" FontSize="11" Margin="0,8,0,0"/>
                                </StackPanel>
                            </Border>

                            <!-- B2: Membership Backfill -->
                            <TextBlock Text="Membership Backfill" Style="{StaticResource SectionHeader}" Margin="0,12,0,0"/>
                            <Border Style="{StaticResource SectionBorder}">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                        <TextBlock Text="cache folder" VerticalAlignment="Center" Margin="0,0,4,0" Foreground="{DynamicResource BrushText}" FontSize="12"/>
                                        <TextBox x:Name="TxtBfCache" Width="360" Text="Cache" Style="{StaticResource FieldBox}" VerticalAlignment="Center"
                                                 ToolTip="Folder of enumeration snapshots to replay (default Cache)."/>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                        <TextBlock Text="output dir" VerticalAlignment="Center" Margin="0,0,4,0" Foreground="{DynamicResource BrushText}" FontSize="12"/>
                                        <TextBox x:Name="TxtBfOut" Width="360" Text="Output/backfill-state" Style="{StaticResource FieldBox}" VerticalAlignment="Center"
                                                 ToolTip="ISOLATED output dir (NEVER the live State\). Default Output\backfill-state keeps the tool's live-State refusal guard from tripping."/>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                        <CheckBox x:Name="ChkBfEmitFeed" Content="Emit per-day change feed" Style="{StaticResource FieldCheckBox}" VerticalAlignment="Center"/>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                        <CheckBox x:Name="ChkBfForce" Content="Force rebuild" Style="{StaticResource FieldCheckBox}" VerticalAlignment="Center"
                                                  ToolTip="Rebuild even if state exists (passes -Force). Off by default."/>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                        <Button x:Name="BtnBfRun" Content="Membership Backfill" Style="{StaticResource SecondaryButton}"
                                                HorizontalAlignment="Left" ToolTip="Run Invoke-MembershipBackfill.ps1 against the isolated output dir."/>
                                    </StackPanel>
                                    <TextBlock x:Name="TxtBfResult" Text="" TextWrapping="Wrap" FontFamily="Consolas" FontSize="11" Margin="0,8,0,0"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </TabItem>

            <!-- ========================================================
                 Tab 5: Results (output files + history)
                 ======================================================== -->
            <TabItem Header="Results" Style="{StaticResource ToolkitTabItem}">
                <Grid Background="{DynamicResource BrushBackground}" Margin="12,8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>     <!-- Output files DataGrid -->
                        <RowDefinition Height="Auto"/>  <!-- Action bar -->
                    </Grid.RowDefinitions>

                    <!-- Output Files DataGrid -->
                    <Border Grid.Row="0" Background="{DynamicResource BrushSurface}"
                            CornerRadius="6" BorderBrush="{DynamicResource BrushBorder}"
                            BorderThickness="1">
                        <DataGrid x:Name="DgOutputFiles"
                                  AutoGenerateColumns="False"
                                  Style="{StaticResource DataGridStyle}"
                                  CellStyle="{StaticResource DataGridCellStyle}">
                            <DataGrid.ContextMenu>
                                <ContextMenu>
                                    <MenuItem x:Name="MnuCopyPath" Header="Copy Path"/>
                                    <MenuItem x:Name="MnuOpenFile" Header="Open File"/>
                                    <MenuItem x:Name="MnuOpenFolder" Header="Open Containing Folder"/>
                                </ContextMenu>
                            </DataGrid.ContextMenu>
                            <DataGrid.ColumnHeaderStyle>
                                <Style TargetType="DataGridColumnHeader"
                                       BasedOn="{StaticResource DataGridColumnHeaderStyle}"/>
                            </DataGrid.ColumnHeaderStyle>
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="File Name"
                                                    Binding="{Binding FileName}"
                                                    Width="*" IsReadOnly="True"/>
                                <DataGridTextColumn Header="Type"
                                                    Binding="{Binding Type}"
                                                    Width="120" IsReadOnly="True"/>
                                <DataGridTextColumn Header="Size"
                                                    Binding="{Binding Size}"
                                                    Width="80" IsReadOnly="True"/>
                                <DataGridTextColumn Header="Generated"
                                                    Binding="{Binding Generated}"
                                                    Width="160" IsReadOnly="True"/>
                                <DataGridTextColumn Header="Full Path"
                                                    Binding="{Binding FullPath}"
                                                    Width="0" IsReadOnly="True"
                                                    Visibility="Collapsed"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Border>

                    <!-- Action Bar -->
                    <Grid Grid.Row="1" Margin="0,10,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Button Grid.Column="0" x:Name="BtnOpenOutputDir"
                                Content="Open Output Directory"
                                Style="{StaticResource SecondaryButton}"
                                Margin="0,0,8,0"
                                ToolTip="Open the output directory in Windows Explorer"/>
                        <Button Grid.Column="1" x:Name="BtnRefreshResults"
                                Content="Refresh"
                                Style="{StaticResource SecondaryButton}"
                                ToolTip="Scan the output directory for generated files"/>
                    </Grid>
                </Grid>
            </TabItem>

            <!-- ========================================================
                 Tab 6: Help (documentation)
                 ======================================================== -->
            <TabItem Header="Help" Style="{StaticResource ToolkitTabItem}">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Background="{DynamicResource BrushBackground}">
                    <StackPanel Margin="12,8">

                        <!-- Header -->
                        <TextBlock Text="Group Enumerator v3.0"
                                   Foreground="{DynamicResource BrushPrimary}"
                                   FontSize="18" FontWeight="Bold"
                                   Margin="0,4,0,4"/>
                        <TextBlock Text="Active Directory Group Membership Enumeration and Migration Readiness Tool"
                                   Foreground="{DynamicResource BrushTextMuted}"
                                   FontSize="12" Margin="0,0,0,16"/>

                        <!-- Quick Start -->
                        <TextBlock Text="Quick Start Guide" Style="{StaticResource SectionHeader}" Margin="0,0,0,8"/>
                        <Border Style="{StaticResource SectionBorder}">
                            <StackPanel>
                                <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource BrushText}" FontSize="12" Margin="0,0,0,8">
                                    1. Go to the Run tab and select a CSV file containing group names or group pairs.
                                </TextBlock>
                                <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource BrushText}" FontSize="12" Margin="0,0,0,8">
                                    2. Choose a Preset to automatically configure options for common workflows.
                                </TextBlock>
                                <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource BrushText}" FontSize="12" Margin="0,0,0,8">
                                    3. (Optional) Fine-tune options in the Enumeration and Reports tabs.
                                </TextBlock>
                                <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource BrushText}" FontSize="12" Margin="0,0,0,8">
                                    4. Review the Command Preview and click Run Enumeration.
                                </TextBlock>
                                <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource BrushText}" FontSize="12">
                                    5. View results in the Results tab or open the output directory.
                                </TextBlock>
                            </StackPanel>
                        </Border>

                        <!-- Presets -->
                        <TextBlock Text="Preset Descriptions" Style="{StaticResource SectionHeader}"/>
                        <Border Style="{StaticResource SectionBorder}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="200"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="8"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="8"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="8"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="8"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="8"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <TextBlock Grid.Row="0" Grid.Column="0" Text="Basic Inventory"
                                           Foreground="{DynamicResource BrushPrimary}" FontWeight="SemiBold" FontSize="12"/>
                                <TextBlock Grid.Row="0" Grid.Column="1" TextWrapping="Wrap" FontSize="12"
                                           Foreground="{DynamicResource BrushText}"
                                           Text="Enumerate group members only. No fuzzy matching, no stale detection, no gap analysis."/>

                                <TextBlock Grid.Row="2" Grid.Column="0" Text="Nested+Stale"
                                           Foreground="{DynamicResource BrushPrimary}" FontWeight="SemiBold" FontSize="12"/>
                                <TextBlock Grid.Row="2" Grid.Column="1" TextWrapping="Wrap" FontSize="12"
                                           Foreground="{DynamicResource BrushText}"
                                           Text="Resolve nested groups and detect stale accounts. Good for access review preparation."/>

                                <TextBlock Grid.Row="4" Grid.Column="0" Text="Cross-Domain Migration"
                                           Foreground="{DynamicResource BrushPrimary}" FontWeight="SemiBold" FontSize="12"/>
                                <TextBlock Grid.Row="4" Grid.Column="1" TextWrapping="Wrap" FontSize="12"
                                           Foreground="{DynamicResource BrushText}"
                                           Text="Full migration readiness: fuzzy match, nested resolution, stale detection, gap analysis, and migration report."/>

                                <TextBlock Grid.Row="6" Grid.Column="0" Text="Compliance Audit"
                                           Foreground="{DynamicResource BrushPrimary}" FontWeight="SemiBold" FontSize="12"/>
                                <TextBlock Grid.Row="6" Grid.Column="1" TextWrapping="Wrap" FontSize="12"
                                           Foreground="{DynamicResource BrushText}"
                                           Text="Point-in-time audit with change tracking, compliance report, and executive dashboard."/>

                                <TextBlock Grid.Row="8" Grid.Column="0" Text="Full Analysis"
                                           Foreground="{DynamicResource BrushPrimary}" FontWeight="SemiBold" FontSize="12"/>
                                <TextBlock Grid.Row="8" Grid.Column="1" TextWrapping="Wrap" FontSize="12"
                                           Foreground="{DynamicResource BrushText}"
                                           Text="All options enabled. Generates all reports. Use for comprehensive one-time analysis."/>

                                <TextBlock Grid.Row="10" Grid.Column="0" Text="Custom"
                                           Foreground="{DynamicResource BrushPrimary}" FontWeight="SemiBold" FontSize="12"/>
                                <TextBlock Grid.Row="10" Grid.Column="1" TextWrapping="Wrap" FontSize="12"
                                           Foreground="{DynamicResource BrushText}"
                                           Text="Manually select individual options in the Enumeration and Reports tabs."/>
                            </Grid>
                        </Border>

                        <!-- Parameter Reference -->
                        <TextBlock Text="Key Parameters" Style="{StaticResource SectionHeader}"/>
                        <Border Style="{StaticResource SectionBorder}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="200"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="6"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="6"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="6"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="6"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="6"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="6"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <TextBlock Grid.Row="0" Grid.Column="0" Text="-CsvPath"
                                           Foreground="{DynamicResource BrushWarning}" FontFamily="Consolas" FontSize="11"/>
                                <TextBlock Grid.Row="0" Grid.Column="1" Text="Path to the input CSV file (required)"
                                           Foreground="{DynamicResource BrushText}" FontSize="11"/>

                                <TextBlock Grid.Row="2" Grid.Column="0" Text="-FuzzyMatch"
                                           Foreground="{DynamicResource BrushWarning}" FontFamily="Consolas" FontSize="11"/>
                                <TextBlock Grid.Row="2" Grid.Column="1" Text="Enable Levenshtein similarity matching"
                                           Foreground="{DynamicResource BrushText}" FontSize="11"/>

                                <TextBlock Grid.Row="4" Grid.Column="0" Text="-ResolveNested"
                                           Foreground="{DynamicResource BrushWarning}" FontFamily="Consolas" FontSize="11"/>
                                <TextBlock Grid.Row="4" Grid.Column="1" Text="Flatten nested group memberships"
                                           Foreground="{DynamicResource BrushText}" FontSize="11"/>

